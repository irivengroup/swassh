{
  "schema_version": 1,
  "name": "demo-dependencies",
  "steps": [
    {
      "id": "inspect-os",
      "hosts": ["srv01"],
      "command": "uname -s"
    },
    {
      "id": "create-directory",
      "hosts": ["srv01"],
      "needs": ["inspect-os"],
      "action": {
        "schema_version": 1,
        "name": "demo-directory",
        "check": "test -d \"$HOME/swassh-demo\"",
        "apply": "umask 077; mkdir \"$HOME/swassh-demo\"",
        "verify": "test -d \"$HOME/swassh-demo\""
      }
    }
  ]
}
